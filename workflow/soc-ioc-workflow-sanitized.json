    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const d = item.json;\n\n  const vtMalicious = Number(d.vt_malicious || 0);\n  const vtSuspicious = Number(d.vt_suspicious || 0);\n  const abuseScore = Number(d.abuse_score || 0);\n  const totalReports = Number(d.abuse_total_reports || 0);\n  const isTor = d.abuse_is_tor === true;\n  const isWhitelisted = d.abuse_is_whitelisted === true;\n\n  let riskScore = 0;\n\n  // VirusTotal contribution\n  riskScore += Math.min(vtMalicious * 10, 40);\n  riskScore += Math.min(vtSuspicious * 5, 10);\n\n  // AbuseIPDB contribution\n  riskScore += Math.min(abuseScore * 0.4, 40);\n\n  // Number of AbuseIPDB reports\n  if (totalReports >= 100) {\n    riskScore += 10;\n  } else if (totalReports >= 20) {\n    riskScore += 5;\n  }\n\n  // Tor exit node\n  if (isTor) {\n    riskScore += 10;\n  }\n\n  // Reduce score for whitelisted IPs\n  if (isWhitelisted) {\n    riskScore -= 10;\n  }\n\n  // Keep score between 0 and 100\n  riskScore = Math.max(0, Math.min(100, Math.round(riskScore)));\n\n  let riskLevel;\n\n  if (riskScore >= 70) {\n    riskLevel = \"CRITICAL\";\n  } else if (riskScore >= 40) {\n    riskLevel = \"HIGH\";\n  } else if (riskScore >= 20) {\n    riskLevel = \"MEDIUM\";\n  } else {\n    riskLevel = \"LOW\";\n  }\n\n  let recommendedAction;\n\n  if (riskLevel === \"CRITICAL\") {\n    recommendedAction =\n      \"Escalate immediately. Consider blocking the IP, investigate affected assets and related network activity, and initiate incident response procedures if malicious activity is confirmed.\";\n  } else if (riskLevel === \"HIGH\") {\n    recommendedAction =\n      \"Investigate immediately. Review associated hosts, users, logs, and connections, and consider blocking the IP if malicious activity is confirmed.\";\n  } else if (riskLevel === \"MEDIUM\") {\n    recommendedAction =\n      \"Review related logs and network activity. Continue monitoring the IP for additional suspicious indicators or repeated connections.\";\n  } else {\n    recommendedAction =\n      \"Continue monitoring. No immediate blocking action is required unless additional suspicious activity is detected.\";\n  }\n\n  return {\n    json: {\n      ...d,\n      risk_score: riskScore,\n      risk_level: riskLevel,\n      recommended_action: recommendedAction,\n      analysis_summary:\n        `Alert ${d.alert_id || \"N/A\"} (${d.alert_name || \"Unknown Alert\"}) from ${d.alert_source || \"Unknown Source\"} detected IP ${d.ip_address || d.vt_ip || d.abuse_ip} on host ${d.affected_host || \"N/A\"}. Risk score: ${riskScore}/100 (${riskLevel}).`\n    }\n  };\n});"
      },
